# Application
APP_NAME=Image Quality Detector
APP_VERSION=1.0.0
DEBUG=false

# Database (SQLite default, change to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/quality.db

# Storage
UPLOAD_DIR=./data/uploads
HEATMAP_DIR=./data/heatmaps
MODEL_DIR=./ml/models

# CORS (comma-separated list in JSON array format)
CORS_ORIGINS=["http://localhost:3000"]

# File limits
MAX_FILE_SIZE_MB=20
